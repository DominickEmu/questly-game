# Google OAuth 2.0 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Where Google redirects after consent (must match the URI in Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gcal/callback

# Frontend origin for post-auth redirect
FRONTEND_ORIGIN=http://localhost:5173

# Anthropic API key for AI story generation (get from console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
